{
  "name": "seven23",
  "version": "2.2.1",
  "description": "seven23",
  "scripts": {
    "start": "webpack serve --config webpack-dev-server.config.js",
    "test": "npx jest --coverage",
    "test:watch": "npx jest --coverage --watch",
    "build": "webpack --config webpack-production.config.js;cp build/index.html build/404.html; cp build/index.html build/401.html",
    "build:no-progress": "webpack --config webpack-production.config.js;cp build/index.html build/404.html; cp build/index.html build/401.html",
    "serve:build": "npx http-server ./build -s -H localhost -p 8080 ",
    "backend": "docker run --env-file ./.env -p 8000:8000 -t -i sebastienbarbier/seven23",
    "format": "prettier --trailing-comma es5 --write '{src,__{tests,mocks}__}/**/*.js' --plugin=prettier-plugin-organize-imports --check",
    "format:fix": "prettier --trailing-comma es5 --write '{src,__{tests,mocks}__}/**/*.js' --plugin=prettier-plugin-organize-imports",
    "lint": "npx eslint '{src,__{tests,mocks}__}/**/*.js'",
    "lint:fix": "npm run lint -- --fix",
    "e2e": "npx cypress run",
    "e2e:build": "npx cypress run --config-file ./cypress/config/cypress.production.config.js",
    "e2e:cli": "start-server-and-test serve:build http://127.0.0.1:8080 e2e:build",
    "heroku-postbuild": "npm run build",
    "predeploy": "./scripts/predeploy.sh",
    "deploy": "./scripts/deploy.sh",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "private": true,
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.4",
    "cypress": "^15.19.0",
    "dotenv": "^17.4.2",
    "es6-promise": "4.2.8",
    "eslint": "^10.8.0",
    "eslint-cli": "1.1.1",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "file-loader": "^6.2.0",
    "globals": "^17.8.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-quick": "^4.2.2",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "start-server-and-test": "^3.0.12",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@date-io/moment": "^3.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "@sentry/browser": "^10.69.0",
    "@sentry/webpack-plugin": "^5.4.0",
    "async": "^3.2.6",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.19.0",
    "babel-jest": "^30.4.1",
    "blueimp-md5": "^2.19.0",
    "browserslist": "^4.28.7",
    "caniuse-lite": "^1.0.30001806",
    "copy-webpack-plugin": "^14.0.0",
    "country-flag-emoji": "^1.0.3",
    "d3": "^7.9.0",
    "history": "^5.3.0",
    "http-server": "^14.1.1",
    "jose": "^6.2.6",
    "moment": "^2.30.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-autosuggest": "^10.1.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^19.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "redux": "^5.0.1",
    "redux-persist": "6.0.0",
    "redux-thunk": "^3.1.0",
    "swiper": "^14.0.7",
    "uuid": "^14.0.1",
    "workbox-webpack-plugin": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
